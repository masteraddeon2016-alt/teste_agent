{
  "ConnectionStrings": {
    "ServiceNowInstance": "https://<INSTANCIA>.service-now.com",
    "AuditDatabase": "Server=<HOST>;Database=espacolaser_audit;User Id=<USER>;Password=<SENHA>;Encrypt=true;"
  },
  "ServiceNow": {
    "InstanceUrl": "https://<INSTANCIA>.service-now.com",
    "ScopedAppNamespace": "x_espaco",
    "ApiBasePath": "/api/x_espaco",
    "OAuth": {
      "ClientId": "<COLE_SEU_CLIENT_ID_AQUI>",
      "ClientSecret": "<COLE_SEU_CLIENT_SECRET_AQUI>",
      "TokenEndpoint": "https://<INSTANCIA>.service-now.com/oauth_token.do",
      "Scope": "useraccount"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "https://<INSTANCIA>.service-now.com",
      "Audience": "x_espaco.api",
      "SigningKey": "<COLE_SUA_CHAVE_JWT_AQUI>",
      "ExpirationMinutes": 60
    },
    "Saml": {
      "IdpMetadataUrl": "<URL_METADATA_SSO>",
      "Enabled": true
    }
  },
  "BridgeAgents": [
    {
      "id": "43fed37d-d7a7-4c34-9cc4-cdce81fdda48",
      "nome": "localmachine",
      "token": "<COLE_SEU_TOKEN_AQUI>",
      "role": "build-dev"
    },
    {
      "id": "ce9423e3-ab2c-457e-a1f6-62ff93fdfdbd",
      "nome": "localmachine2",
      "token": "<COLE_SEU_TOKEN_AQUI>",
      "role": "integracao-cd"
    }
  ],
  "Integrations": {
    "Crm": {
      "BaseUrl": "https://crm.espacolaser.com/api/clientes",
      "CredentialAlias": "x_espaco.crm_credential",
      "TimeoutSeconds": 30
    },
    "Financeiro": {
      "BaseUrl": "https://financeiro.espacolaser.com/api/faturamento",
      "CredentialAlias": "x_espaco.financeiro_credential",
      "TimeoutSeconds": 30
    },
    "Notificacoes": {
      "BaseUrl": "https://notify.espacolaser.com/api/send",
      "CredentialAlias": "x_espaco.notify_credential",
      "Channels": ["email", "sms", "whatsapp"]
    }
  },
  "Lgpd": {
    "ConsentTermVersion": "1.0",
    "RetentionMonths": 60,
    "AnonymizationHashSalt": "<COLE_SEU_SALT_AQUI>",
    "DpoEmail": "dpo@espacolaser.com"
  },
  "BusinessRules": {
    "CancelamentoAntecedenciaHoras": 24,
    "LimitePaginacaoPadrao": 20,
    "LimitePaginacaoMax": 100,
    "LembreteSessaoHorasAntes": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
