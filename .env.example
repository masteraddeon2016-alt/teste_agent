# ============================================================
# Espaço Laser — Variáveis de Ambiente (EXEMPLO)
# Copie para .env e preencha. NUNCA comite o .env real.
# ============================================================

# ----- Instância ServiceNow -----
SN_INSTANCE_URL=https://<INSTANCIA>.service-now.com
SN_SCOPE=x_espaco
SN_API_BASE=/api/x_espaco

# ----- Credenciais de serviço ServiceNow (uso do Agente Bridge) -----
SN_SERVICE_USER=<usuario_integracao>
SN_SERVICE_PASSWORD=<senha_integracao>

# ----- OAuth 2.0 (integrações externas) -----
SN_OAUTH_CLIENT_ID=<client_id>
SN_OAUTH_CLIENT_SECRET=<client_secret>
SN_OAUTH_TOKEN_URL=https://<INSTANCIA>.service-now.com/oauth_token.do

# ----- JWT (APIs internas) -----
JWT_ISSUER=https://<INSTANCIA>.service-now.com
JWT_AUDIENCE=x_espaco.api
JWT_SIGNING_KEY=<chave_secreta_jwt>
JWT_EXPIRATION_MINUTES=60

# ----- Agentes Bridge (tokens) -----
BRIDGE_AGENT_LOCALMACHINE_ID=43fed37d-d7a7-4c34-9cc4-cdce81fdda48
BRIDGE_AGENT_LOCALMACHINE_TOKEN=<token_localmachine>
BRIDGE_AGENT_LOCALMACHINE2_ID=ce9423e3-ab2c-457e-a1f6-62ff93fdfdbd
BRIDGE_AGENT_LOCALMACHINE2_TOKEN=<token_localmachine2>

# ----- Integrações externas -----
CRM_BASE_URL=https://crm.espacolaser.com/api/clientes
CRM_API_KEY=<crm_api_key>
FINANCEIRO_BASE_URL=https://financeiro.espacolaser.com/api/faturamento
FINANCEIRO_API_KEY=<financeiro_api_key>
NOTIFY_BASE_URL=https://notify.espacolaser.com/api/send
NOTIFY_API_KEY=<notify_api_key>

# ----- LGPD -----
LGPD_CONSENT_VERSION=1.0
LGPD_ANON_SALT=<salt_para_hash_anonimizacao>
LGPD_DPO_EMAIL=dpo@espacolaser.com
LGPD_RETENTION_MONTHS=60

# ----- Regras de negócio -----
CANCELAMENTO_ANTECEDENCIA_HORAS=24
LEMBRETE_HORAS_ANTES=24
PAGINACAO_PADRAO=20
PAGINACAO_MAX=100

# ----- Git Source Control -----
GIT_REPO_URL=https://github.com/espacolaser/teste_agent.git
GIT_BRANCH=develop
GIT_TOKEN=<git_access_token>
